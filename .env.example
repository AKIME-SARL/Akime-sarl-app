# A-KIME SARL environment template
# Copy this file to .env and set production values through the deployment
# environment or GitHub Environment secrets. Never commit .env.

# Application
NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
# Keep the admin listener private. Use a local reverse proxy or VPN to expose it.
ADMIN_HOST=127.0.0.1
ADMIN_URL=http://localhost:4001
BASE_URL=http://localhost:4000
TRUST_PROXY=false

# Database
# Production: use mongodb+srv:// or enable TLS with tls=true.
MONGODB_URI=mongodb://127.0.0.1:27017/akime

# Authentication — generate independent, cryptographically random values.
JWT_SECRET=<generate-64-byte-hex-secret>
JWT_REFRESH_SECRET=<generate-a-second-64-byte-hex-secret>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=<generate-a-third-64-byte-hex-secret>

# Administration
ALLOWED_ADMIN_EMAILS=admin@example.com
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_NAME=Administrator

# Rate limiting
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=900000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# CORS
ORIGIN=http://localhost:4000,http://localhost:4001

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf

# Email
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=mailer@example.com
EMAIL_PASS=<smtp-app-password>
EMAIL_FROM=mailer@example.com
COMPANY_NAME=A-KIME SARL
COMPANY_EMAIL=info@example.com
COMPANY_PHONE=<company-phone>
COMPANY_ADDRESS=<company-address>

# OAuth
GOOGLE_CLIENT_ID=<google-oauth-client-id>

# Public social links
FACEBOOK_URL=https://www.facebook.com/example
LINKEDIN_URL=https://www.linkedin.com/company/example

# Local backup behaviour; backup files remain ignored by Git.
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=backups
