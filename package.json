{
  "name": "akime-website",
  "version": "6.2.0",
  "description": "A-KIME Sarl website with content management system",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "create-admin": "node scripts/create-admin.js",
    "test-mongodb": "node scripts/test-mongodb.js",
    "test-db": "node scripts/simple-mongodb-test.js",
