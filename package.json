  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "10.3.1",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
