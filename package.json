    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "seed": "node scripts/seed.js",
    "fix-admin-roles": "node scripts/fix-admin-roles.js",
    "migrate-legacy-content-ids": "node scripts/migrate-legacy-content-ids.js",
    "security-remediate": "node scripts/security-remediate.js --apply",
